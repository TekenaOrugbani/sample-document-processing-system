<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ImplicitUsings>enable</ImplicitUsings>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>
  <!-- Legacy Web Forms code-behind and designer files — fully replaced by Blazor components -->
  <ItemGroup>
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="ErrorPage.aspx.cs" />
    <Compile Remove="ErrorPage.aspx.designer.cs" />
    <Compile Remove="Controls\DocumentUploader.ascx.cs" />
    <Compile Remove="Controls\DocumentUploader.ascx.designer.cs" />
  </ItemGroup>
  <!-- Legacy Web Forms markup files — not compilable and not used -->
  <ItemGroup>
    <Content Remove="Site.Master" />
    <Content Remove="ErrorPage.aspx" />
    <Content Remove="Controls\DocumentUploader.ascx" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.0" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.6" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.7" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
