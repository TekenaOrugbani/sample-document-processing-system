<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyTitle>DocumentProcessor.WebForms</AssemblyTitle>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Copyright>Copyright ©  2015</Copyright>
    <Description>Document Processing System - ASP.NET Web Forms</Description>
    <FileVersion>1.0.0.0</FileVersion>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <GenerateAssemblyInformationalVersionAttribute>false</GenerateAssemblyInformationalVersionAttribute>
    <GenerateNeutralResourcesLanguageAttribute>false</GenerateNeutralResourcesLanguageAttribute>
    <ImplicitUsings>enable</ImplicitUsings>
    <Product>DocumentProcessor.WebForms</Product>
    <TargetFramework>net10.0</TargetFramework>
    <WarningsAsErrors>$(WarningsAsErrors);RZ10012</WarningsAsErrors>
  </PropertyGroup>
  <!-- Assembly attributes moved from Properties/AssemblyInfo.cs -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>025ca867-fcdb-415f-887a-f3c5505ff750</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>
  <!-- Exclude legacy Web Forms designer and code-behind files that have been replaced by Blazor components -->
  <ItemGroup>
    <Compile Remove="Site.Master.cs" />
    <Compile Remove="Site.Master.designer.cs" />
    <Compile Remove="Default.aspx.cs" />
    <Compile Remove="Default.aspx.designer.cs" />
    <Compile Remove="ErrorPage.aspx.cs" />
    <Compile Remove="ErrorPage.aspx.designer.cs" />
    <Compile Remove="Controls\DocumentList.ascx.cs" />
    <Compile Remove="Controls\DocumentList.ascx.designer.cs" />
    <Compile Remove="Controls\DocumentUploader.ascx.cs" />
    <Compile Remove="Controls\DocumentUploader.ascx.designer.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="AWSSDK.BedrockRuntime" Version="4.0.101.13" />
    <PackageReference Include="AWSSDK.Core" Version="4.0.102.16" />
    <PackageReference Include="AWSSDK.SecretsManager" Version="4.0.100.22" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>
</Project>
