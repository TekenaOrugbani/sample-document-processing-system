@using DocumentProcessor.WebForms.Configuration
@using DocumentProcessor.WebForms.Models
@using DocumentProcessor.WebForms.Services

<h1 class="upload-title">Upload a document and I'll summarize it.</h1>
<p class="upload-subtitle">
    @fileTypeSummaryText
    &middot; up to @AppSettings.StorageMaxFileSizeMegabytes MB
</p>

<div class="dropzone">
    <InputFile OnChange="OnFilesSelected" multiple class="dropzone-input"
               title="Drag files here or click to browse" @ref="fileInput" />
    <div class="dropzone-icon"><i class="bi bi-cloud-arrow-up"></i></div>
    <p class="dropzone-hint">Drag files here</p>
    <span class="btn-brand">Browse files</span>
</div>

@if (selectedFiles.Count > 0)
{
    <ul class="selected-list">
        @foreach (var file in selectedFiles)
        {
            <li class="selected-item">
                <small>@file.Name (@FormatSize(file.Size))</small>
            </li>
        }
    </ul>

    <div class="d-flex gap-2 mt-3">
        <button type="button" class="@($"btn-brand{(isUploading ? " is-busy" : "")}")"
                disabled="@isUploading" @onclick="HandleUploadAsync">
            @if (isUploading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>Uploading...</span>
            }
            else
            {
                <span>Upload @selectedFiles.Count @(selectedFiles.Count == 1 ? "file" : "files")</span>
            }
        </button>
        <button type="button" class="btn-quiet" disabled="@isUploading" @onclick="ClearSelection">Clear</button>
    </div>
}

@if (isUploading)
{
    <p class="upload-status">
        Uploading @selectedFiles.Count @(selectedFiles.Count == 1 ? "file" : "files").
        Each document is summarized before the page comes back, so this can take a while.
    </p>
}

@foreach (var notice in notifications)
{
    <div class="notice notice-@notice.CssSuffix">
        <i class="bi @notice.IconClass"></i>
        <span>@notice.Text</span>
    </div>
}

@code {
    /// <summary>
    /// Raised once the posted files have passed size and extension checks.
    /// The parent page stores them and runs the pipeline; this control only deals with the form.
    /// </summary>
    [Parameter]
    public EventCallback<IReadOnlyList<IBrowserFile>> UploadRequested { get; set; }

    private InputFile? fileInput;
    private List<IBrowserFile> selectedFiles = new();
    private List<Notification> notifications = new();
    private bool isUploading;
    private string fileTypeSummaryText = string.Empty;

    protected override void OnInitialized()
    {
        var extensions = AppSettings.StorageAllowedExtensions
            .Select(extension => extension.TrimStart('.').ToUpperInvariant());

        fileTypeSummaryText = string.Join(", ", extensions);
    }

    /// <summary>Adds a message shown under the dropzone. Call before the next render.</summary>
    public void Notify(string text, NotificationLevel level)
    {
        notifications.Add(new Notification(text, level));
    }

    private void OnFilesSelected(InputFileChangeEventArgs e)
    {
        notifications.Clear();
        selectedFiles = e.GetMultipleFiles(maximumFileCount: 100).ToList();
    }

    private void ClearSelection()
    {
        selectedFiles.Clear();
        notifications.Clear();
    }

    private async Task HandleUploadAsync()
    {
        notifications.Clear();

        var maxFiles = AppSettings.StorageMaxFilesPerUpload;
        var maxBytes = AppSettings.StorageMaxFileSizeBytes;
        var allowed = AppSettings.StorageAllowedExtensions;

        var posted = selectedFiles
            .Where(file => file != null && !string.IsNullOrEmpty(file.Name))
            .ToList();

        if (posted.Count == 0)
        {
            Notify("Choose at least one file to upload.", NotificationLevel.Warning);
            return;
        }

        if (posted.Count > maxFiles)
        {
            Notify(
                string.Format("Only the first {0} files were taken from this upload.", maxFiles),
                NotificationLevel.Warning);

            posted = posted.Take(maxFiles).ToList();
        }

        var accepted = new List<IBrowserFile>();

        foreach (var file in posted)
        {
            var name = Path.GetFileName(file.Name);

            if (file.Size > maxBytes)
            {
                Notify(
                    string.Format("'{0}' exceeds {1} MB", name, AppSettings.StorageMaxFileSizeMegabytes),
                    NotificationLevel.Warning);
                continue;
            }

            var extension = Path.GetExtension(name).ToLowerInvariant();

            if (!allowed.Contains(extension) || !DocumentTextExtractor.CanExtract(extension))
            {
                Notify(
                    string.Format("'{0}' is not a supported file type", name),
                    NotificationLevel.Warning);
                continue;
            }

            accepted.Add(file);
        }

        if (accepted.Count > 0 && UploadRequested.HasDelegate)
        {
            isUploading = true;
            StateHasChanged();

            try
            {
                await UploadRequested.InvokeAsync(accepted);
            }
            finally
            {
                isUploading = false;
                selectedFiles.Clear();
            }
        }
    }

    private static string FormatSize(long bytes)
    {
        string[] units = { "B", "KB", "MB", "GB" };
        double size = bytes;
        int unit = 0;

        while (size >= 1024 && unit < units.Length - 1)
        {
            size /= 1024;
            unit++;
        }

        return $"{Math.Round(size, 2)} {units[unit]}";
    }
}
