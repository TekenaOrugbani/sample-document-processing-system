@page "/"
@page "/Default"
@rendermode InteractiveServer
@using DocumentProcessor.WebForms.Models
@using DocumentProcessor.WebForms.Services
@using DocumentProcessor.WebForms.Data
@using DocumentProcessor.WebForms.Components.Controls.Controls
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.Logging

@inject DocumentDbContext Db
@inject IDocumentStorage Storage
@inject DocumentPipeline Pipeline
@inject ILogger<Default> Logger

<PageTitle>Document Processor</PageTitle>

<div class="app-grid">
    <section>
        @* File upload — the original was outside the UpdatePanel because file inputs
           could not post through an asynchronous postback. In Blazor the InputFile
           component works natively with interactive rendering. *@
        <DocumentUploader UploadRequested="OnUploadRequested" Notifications="_notifications" />
    </section>

    <section>
        <DocumentList Documents="_documents"
                      RefreshRequested="OnRefreshRequested"
                      ViewSummaryRequested="OnViewSummaryRequested"
                      DeleteRequested="OnDeleteRequested" />

        @if (_showSummaryModal)
        {
            <div class="modal fade show d-block modal-backdrop-tint" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title">@_summaryModalTitle</h6>
                            <a href="#" class="btn-close" @onclick="CloseSummaryModal" @onclick:preventDefault></a>
                        </div>
                        <div class="modal-body">
                            <p>@_summaryModalBody</p>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-sm btn-secondary" @onclick="CloseSummaryModal" @onclick:preventDefault>Close</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_showDeleteModal)
        {
            <div class="modal fade show d-block modal-backdrop-tint" tabindex="-1">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title">Delete document?</h6>
                            <a href="#" class="btn-close" @onclick="CancelDelete" @onclick:preventDefault></a>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0"><strong>@_deleteModalFileName</strong></p>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-sm btn-secondary" @onclick="CancelDelete" @onclick:preventDefault>Cancel</a>
                            <a href="#" class="btn btn-sm btn-danger" @onclick="ConfirmDelete" @onclick:preventDefault>Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="update-progress"><span class="spinner-border"></span></div>
        }
    </section>
</div>

@code {
    private const int MaxDocumentsShown = 50;

    private List<Document> _documents = new();
    private List<Notification> _notifications = new();

    // Summary modal state
    private bool _showSummaryModal;
    private string _summaryModalTitle = string.Empty;
    private string _summaryModalBody = string.Empty;

    // Delete modal state (replaces ViewState[DeleteTargetId])
    private bool _showDeleteModal;
    private string _deleteModalFileName = string.Empty;
    private Guid? _deleteTargetId;

    // Processing indicator (replaces UpdateProgress)
    private bool _isProcessing;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentsAsync();
    }

    private async Task OnUploadRequested(IList<IBrowserFile> files)
    {
        _notifications.Clear();
        _isProcessing = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                var name = Path.GetFileName(file.Name);

                try
                {
                    var document = await StoreAsync(file, name);

                    // Pipeline.ProcessAsync calls Bedrock ConverseAsync — must be async
                    // to avoid freezing the Blazor Server circuit.
                    await Pipeline.ProcessAsync(document.Id);

                    _notifications.Add(new Notification($"'{name}' processed", NotificationLevel.Success));
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Upload failed for {FileName}", name);
                    _notifications.Add(new Notification($"'{name}' failed to upload", NotificationLevel.Danger));
                }
            }

            await LoadDocumentsAsync();
        }
        finally
        {
            _isProcessing = false;
        }
    }

    private async Task OnRefreshRequested()
    {
        _notifications.Clear();
        await LoadDocumentsAsync();
    }

    private async Task OnViewSummaryRequested(Guid documentId)
    {
        var document = await FindAsync(documentId);

        if (document == null)
        {
            _notifications.Add(new Notification("That document is no longer available.", NotificationLevel.Warning));
            await LoadDocumentsAsync();
            return;
        }

        _summaryModalTitle = document.OriginalFileName;
        _summaryModalBody = document.Summary ?? string.Empty;
        _showSummaryModal = true;
    }

    private void CloseSummaryModal()
    {
        _showSummaryModal = false;
    }

    private async Task OnDeleteRequested(Guid documentId)
    {
        var document = await FindAsync(documentId);

        if (document == null)
        {
            _notifications.Add(new Notification("That document is no longer available.", NotificationLevel.Warning));
            await LoadDocumentsAsync();
            return;
        }

        _deleteTargetId = document.Id;
        _deleteModalFileName = document.OriginalFileName;
        _showDeleteModal = true;
    }

    private void CancelDelete()
    {
        _deleteTargetId = null;
        _showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (_deleteTargetId is not Guid documentId)
        {
            _showDeleteModal = false;
            return;
        }

        try
        {
            // EF Core global query filter on IsDeleted is configured in DocumentDbContext.
            var document = await Db.Documents.FirstOrDefaultAsync(d => d.Id == documentId);

            if (document != null)
            {
                document.IsDeleted = true;
                await Db.SaveChangesAsync();
            }

            _deleteTargetId = null;
            _showDeleteModal = false;
            await LoadDocumentsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete failed for document {DocumentId}", documentId);
            _notifications.Add(new Notification("Could not delete the document.", NotificationLevel.Danger));
        }
    }

    private async Task LoadDocumentsAsync()
    {
        try
        {
            // EF Core global query filter handles the soft-delete exclusion.
            _documents = await Db.Documents
                .OrderByDescending(d => d.UploadedAt)
                .Take(MaxDocumentsShown)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load documents");
            _documents = new List<Document>();
            _notifications.Add(new Notification("Could not load documents.", NotificationLevel.Danger));
        }
    }

    private async Task<Document?> FindAsync(Guid documentId)
    {
        // EF Core global query filter handles the soft-delete exclusion.
        return await Db.Documents.FirstOrDefaultAsync(d => d.Id == documentId);
    }

    private async Task<Document> StoreAsync(IBrowserFile file, string name)
    {
        var document = new Document
        {
            FileName = name,
            OriginalFileName = name,
            FileExtension = Path.GetExtension(name).ToLowerInvariant(),
            ContentType = file.ContentType,
            FileSize = file.Size,
            UploadedAt = DateTimeOffset.UtcNow,
            Status = DocumentStatus.Pending
        };

        // PORT-TODO
        // {"note": "IDocumentStorage.Save is synchronous and takes a Stream. IBrowserFile.OpenReadStream returns a Stream — this works, but the storage layer should ideally be made async (SaveAsync) to avoid blocking the Blazor circuit on disk I/O. The maxAllowedSize must match the configured upload limit.", "was": "System.Web.HttpPostedFile"}
        await using var stream = file.OpenReadStream(maxAllowedSize: 512 * 1024 * 1024);
        document.StoragePath = Storage.Save(stream, name);

        Db.Documents.Add(document);
        await Db.SaveChangesAsync();

        return document;
    }
}
