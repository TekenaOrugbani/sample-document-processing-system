@page "/"
@page "/Default"
@rendermode InteractiveServer

@using System.Data.Entity
@using DocumentProcessor.WebForms.Data
@using DocumentProcessor.WebForms.Models
@using DocumentProcessor.WebForms.Services
@using Microsoft.AspNetCore.Components.Forms

@inject DocumentDbContext Db
@inject IDocumentStorage Storage
@inject DocumentPipeline Pipeline
@inject ILogger<Default> Logger

<PageTitle>Document Processor</PageTitle>

<div class="app-grid">
    <section>
        @* The uploader raises UploadRequested with the accepted browser files.
           The page stores them and runs the pipeline, then refreshes the list. *@
        <DocumentUploader UploadRequested="OnUploadRequested" />
    </section>

    <section>
        <DocumentList Documents="documents"
                      RefreshRequested="OnRefreshRequested"
                      ViewSummaryRequested="OnViewSummaryRequested"
                      DeleteRequested="OnDeleteRequested" />

        @if (showSummaryModal)
        {
            <div class="modal fade show d-block modal-backdrop-tint" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title">@summaryModalTitle</h6>
                            <a href="#" class="btn-close" @onclick="CloseSummaryModal" @onclick:preventDefault></a>
                        </div>
                        <div class="modal-body">
                            <p>@summaryModalBody</p>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-sm btn-secondary" @onclick="CloseSummaryModal" @onclick:preventDefault>Close</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (showDeleteModal)
        {
            <div class="modal fade show d-block modal-backdrop-tint" tabindex="-1">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title">Delete document?</h6>
                            <a href="#" class="btn-close" @onclick="CancelDelete" @onclick:preventDefault></a>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0"><strong>@deleteModalFileName</strong></p>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-sm btn-secondary" @onclick="CancelDelete" @onclick:preventDefault>Cancel</a>
                            <a href="#" class="btn btn-sm btn-danger" @onclick="ConfirmDelete" @onclick:preventDefault>Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (isProcessing)
        {
            <div class="update-progress"><span class="spinner-border"></span></div>
        }
    </section>
</div>

@code {
    private const int MaxDocumentsShown = 50;

    private List<Document> documents = new();
    private List<Notification> notifications = new();

    private bool showSummaryModal;
    private string summaryModalTitle = string.Empty;
    private string summaryModalBody = string.Empty;

    private bool showDeleteModal;
    private Guid? deleteTargetId;
    private string deleteModalFileName = string.Empty;

    private bool isProcessing;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentsAsync();
    }

    // PORT-TODO
    // {"note": "DocumentUploader child control is not yet ported. When ported, confirm that it exposes [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> UploadRequested and [Parameter] public List<Notification> Notifications. Adjust parameter names and types here if different.", "files": ["Components/Controls/DocumentUploader.razor"]}
    private async Task OnUploadRequested(IReadOnlyList<IBrowserFile> files)
    {
        notifications.Clear();

        foreach (var file in files)
        {
            var name = Path.GetFileName(file.Name);

            try
            {
                var document = await StoreAsync(file, name);

                isProcessing = true;
                StateHasChanged();

                // PORT-TODO
                // {"was": "DocumentProcessor.WebForms.Services.DocumentPipeline.Process", "note": "DocumentPipeline.Process is synchronous and calls synchronous AWS SDK methods. It must be converted to ProcessAsync returning Task. This call assumes the async version exists after the pipeline is ported.", "files": ["Services/DocumentPipeline.cs"]}
                await Pipeline.ProcessAsync(document.Id);

                isProcessing = false;

                notifications.Add(new Notification($"'{name}' processed", NotificationLevel.Success));
            }
            catch (Exception ex)
            {
                isProcessing = false;
                Logger.LogError(ex, "Upload failed for {FileName}", name);
                notifications.Add(new Notification($"'{name}' failed to upload", NotificationLevel.Danger));
            }
        }

        await LoadDocumentsAsync();
    }

    // PORT-TODO
    // {"note": "DocumentList child control is not yet ported. When ported, confirm it exposes [Parameter] public EventCallback RefreshRequested, [Parameter] public EventCallback<Guid> ViewSummaryRequested, [Parameter] public EventCallback<Guid> DeleteRequested, and [Parameter] public List<Document> Documents.", "files": ["Components/Controls/DocumentList.razor"]}
    private async Task OnRefreshRequested()
    {
        await LoadDocumentsAsync();
    }

    private async Task OnViewSummaryRequested(Guid documentId)
    {
        var document = await FindAsync(documentId);

        if (document == null)
        {
            notifications.Add(new Notification("That document is no longer available.", NotificationLevel.Warning));
            await LoadDocumentsAsync();
            return;
        }

        summaryModalTitle = document.OriginalFileName;
        summaryModalBody = document.Summary ?? string.Empty;
        showSummaryModal = true;
    }

    private void CloseSummaryModal()
    {
        showSummaryModal = false;
    }

    private async Task OnDeleteRequested(Guid documentId)
    {
        var document = await FindAsync(documentId);

        if (document == null)
        {
            notifications.Add(new Notification("That document is no longer available.", NotificationLevel.Warning));
            await LoadDocumentsAsync();
            return;
        }

        deleteTargetId = document.Id;
        deleteModalFileName = document.OriginalFileName;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        deleteTargetId = null;
        showDeleteModal = false;
    }

    private async Task ConfirmDelete()
    {
        if (deleteTargetId is not Guid documentId)
        {
            showDeleteModal = false;
            return;
        }

        try
        {
            var document = await Db.Documents
                .FirstOrDefaultAsync(d => d.Id == documentId && !d.IsDeleted);

            if (document != null)
            {
                document.IsDeleted = true;
                await Db.SaveChangesAsync();
            }

            deleteTargetId = null;
            showDeleteModal = false;
            await LoadDocumentsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete failed for document {DocumentId}", documentId);
            notifications.Add(new Notification("Could not delete the document.", NotificationLevel.Danger));
        }
    }

    private async Task LoadDocumentsAsync()
    {
        try
        {
            documents = await Db.Documents
                .Where(d => !d.IsDeleted)
                .OrderByDescending(d => d.UploadedAt)
                .Take(MaxDocumentsShown)
                .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load documents");
            documents = new List<Document>();
            notifications.Add(new Notification("Could not load documents.", NotificationLevel.Danger));
        }
    }

    private async Task<Document?> FindAsync(Guid documentId)
    {
        return await Db.Documents
            .FirstOrDefaultAsync(d => d.Id == documentId && !d.IsDeleted);
    }

    private async Task<Document> StoreAsync(IBrowserFile file, string name)
    {
        var document = new Document
        {
            FileName = name,
            OriginalFileName = name,
            FileExtension = Path.GetExtension(name).ToLowerInvariant(),
            ContentType = file.ContentType,
            FileSize = file.Size,
            UploadedAt = DateTimeOffset.UtcNow,
            Status = DocumentStatus.Pending
        };

        await using var stream = file.OpenReadStream(file.Size);
        document.StoragePath = Storage.Save(stream, name);

        Db.Documents.Add(document);
        await Db.SaveChangesAsync();

        return document;
    }
}
