@page "/"
@page "/Default"
@rendermode InteractiveServer

@using DocumentProcessor.WebForms.Configuration
@using DocumentProcessor.WebForms.Data
@using DocumentProcessor.WebForms.Models
@using DocumentProcessor.WebForms.Services
@using DocumentProcessor.WebForms.Components.Controls.Controls

@inject DocumentDbContext Db
@inject IDocumentStorage Storage
@inject DocumentPipeline Pipeline
@inject ILogger<DocumentProcessor.WebForms.Components.Pages.Default> Logger

<PageTitle>Document Processor</PageTitle>

<div class="app-grid">
    <section>
        @* The uploader was outside the UpdatePanel in WebForms because file inputs
           could not be posted through an asynchronous postback. In Blazor this
           restriction does not apply — the InputFile component handles it natively. *@
        <DocumentUploader @ref="uploaderRef" UploadRequested="OnUploadRequestedAsync" />
    </section>

    <section>
        <DocumentList Documents="documents"
                      RefreshRequested="OnRefreshRequestedAsync"
                      ViewSummaryRequested="OnViewSummaryRequestedAsync"
                      DeleteRequested="OnDeleteRequestedAsync" />

        @if (showSummaryModal)
        {
            <div class="modal fade show d-block modal-backdrop-tint" tabindex="-1">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title">@summaryModalTitle</h6>
                            <a href="#" class="btn-close" @onclick="CloseSummaryModal" @onclick:preventDefault></a>
                        </div>
                        <div class="modal-body">
                            <p>@summaryModalBody</p>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-sm btn-secondary" @onclick="CloseSummaryModal" @onclick:preventDefault>Close</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (showDeleteModal)
        {
            <div class="modal fade show d-block modal-backdrop-tint" tabindex="-1">
                <div class="modal-dialog modal-sm">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h6 class="modal-title">Delete document?</h6>
                            <a href="#" class="btn-close" @onclick="CancelDelete" @onclick:preventDefault></a>
                        </div>
                        <div class="modal-body">
                            <p class="mb-0"><strong>@deleteModalFileName</strong></p>
                        </div>
                        <div class="modal-footer">
                            <a href="#" class="btn btn-sm btn-secondary" @onclick="CancelDelete" @onclick:preventDefault>Cancel</a>
                            <a href="#" class="btn btn-sm btn-danger" @onclick="ConfirmDeleteAsync" @onclick:preventDefault>Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }

        @if (isProcessing)
        {
            <div class="update-progress"><span class="spinner-border"></span></div>
        }
    </section>
</div>

@code {
    private const int MaxDocumentsShown = 50;

    private DocumentUploader? uploaderRef;

    private IList<Document> documents = new List<Document>();

    // Summary modal state (replaces SummaryModal.Visible, SummaryModalTitle.Text, SummaryModalBody.Text)
    private bool showSummaryModal;
    private string summaryModalTitle = string.Empty;
    private string summaryModalBody = string.Empty;

    // Delete modal state (replaces DeleteModal.Visible, DeleteModalFileName.Text, ViewState[DeleteTargetKey])
    private bool showDeleteModal;
    private string deleteModalFileName = string.Empty;
    private Guid? deleteTargetId;

    // Progress indicator (replaces UpdateProgress)
    private bool isProcessing;

    protected override async Task OnInitializedAsync()
    {
        await LoadDocumentsAsync();
    }

    private async Task OnUploadRequestedAsync(IReadOnlyList<IBrowserFile> files)
    {
        isProcessing = true;
        StateHasChanged();

        try
        {
            foreach (var file in files)
            {
                var name = Path.GetFileName(file.Name);

                try
                {
                    var document = await StoreAsync(file, name);

                    // PORT-TODO
                    // {"was": "DocumentProcessor.WebForms.Services.DocumentPipeline.Process", "note": "DocumentPipeline.Process is synchronous and calls Bedrock. Convert to async Task ProcessAsync to avoid blocking the Blazor circuit. Once ProcessAsync exists, replace this call.", "files": ["Services/DocumentPipeline.cs"]}
                    Pipeline.Process(document.Id);

                    uploaderRef?.Notify($"'{name}' processed", NotificationLevel.Success);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Upload failed for {FileName}", name);
                    uploaderRef?.Notify($"'{name}' failed to upload", NotificationLevel.Danger);
                }
            }

            await LoadDocumentsAsync();
        }
        finally
        {
            isProcessing = false;
        }
    }

    private async Task OnRefreshRequestedAsync()
    {
        await LoadDocumentsAsync();
    }

    private async Task OnViewSummaryRequestedAsync(Guid documentId)
    {
        var document = await FindAsync(documentId);

        if (document == null)
        {
            uploaderRef?.Notify("That document is no longer available.", NotificationLevel.Warning);
            await LoadDocumentsAsync();
            return;
        }

        summaryModalTitle = document.OriginalFileName;
        summaryModalBody = document.Summary ?? string.Empty;
        showSummaryModal = true;
    }

    private void CloseSummaryModal()
    {
        showSummaryModal = false;
    }

    private async Task OnDeleteRequestedAsync(Guid documentId)
    {
        var document = await FindAsync(documentId);

        if (document == null)
        {
            uploaderRef?.Notify("That document is no longer available.", NotificationLevel.Warning);
            await LoadDocumentsAsync();
            return;
        }

        deleteTargetId = document.Id;
        deleteModalFileName = document.OriginalFileName;
        showDeleteModal = true;
    }

    private void CancelDelete()
    {
        deleteTargetId = null;
        showDeleteModal = false;
    }

    private async Task ConfirmDeleteAsync()
    {
        if (deleteTargetId is not Guid documentId)
        {
            showDeleteModal = false;
            return;
        }

        try
        {
            var document = Db.Documents.FirstOrDefault(d => d.Id == documentId && !d.IsDeleted);

            if (document != null)
            {
                document.IsDeleted = true;
                Db.SaveChanges();
            }

            deleteTargetId = null;
            showDeleteModal = false;
            await LoadDocumentsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Delete failed for document {DocumentId}", documentId);
            uploaderRef?.Notify("Could not delete the document.", NotificationLevel.Danger);
        }
    }

    private async Task LoadDocumentsAsync()
    {
        try
        {
            documents = Db.Documents
                .Where(d => !d.IsDeleted)
                .OrderByDescending(d => d.UploadedAt)
                .Take(MaxDocumentsShown)
                .ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load documents");
            documents = new List<Document>();
            uploaderRef?.Notify("Could not load documents.", NotificationLevel.Danger);
        }

        await Task.CompletedTask;
    }

    private async Task<Document> StoreAsync(IBrowserFile file, string name)
    {
        var document = new Document
        {
            FileName = name,
            OriginalFileName = name,
            FileExtension = Path.GetExtension(name).ToLowerInvariant(),
            ContentType = file.ContentType,
            FileSize = file.Size,
            UploadedAt = DateTimeOffset.UtcNow,
            Status = DocumentStatus.Pending
        };

        using (var stream = file.OpenReadStream(maxAllowedSize: AppSettings.StorageMaxFileSizeBytes))
        {
            document.StoragePath = Storage.Save(stream, name);
        }

        Db.Documents.Add(document);
        Db.SaveChanges();

        return document;
    }

    private Task<Document?> FindAsync(Guid documentId)
    {
        var document = Db.Documents.FirstOrDefault(d => d.Id == documentId && !d.IsDeleted);
        return Task.FromResult<Document?>(document);
    }
}
